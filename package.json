{
  "name": "dcinside-gallery-maker",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:live": "tsx scripts/live-eval.ts",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build": "npm run typecheck && vite build && tsup server/index.ts --tsconfig tsconfig.server.json --format esm --platform node --target node20 --out-dir dist-server --clean --sourcemap --external vite && npm run bundle:check && node scripts/build-state.mjs --write",
    "smoke": "node scripts/smoke.mjs",
    "verify:core": "npm run lint && npm run format-check && npm run test:coverage && npm run build && npm run smoke",
    "verify": "npm run verify:core && npm run test:e2e",
    "start": "node dist-server/index.js --production",
    "preview": "npm start"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@google/genai": "^2.17.1",
    "express": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/express": "^5.0.3",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
