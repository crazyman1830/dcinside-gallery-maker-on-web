{
  "name": "dcinside-gallery-maker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run lint && vite build && tsup server/index.ts --format esm --platform node --target node20 --out-dir dist-server --clean --sourcemap --external vite",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist-server/index.js --production",
    "preview": "npm start"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@google/genai": "2.14.0",
    "express": "5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.2.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
